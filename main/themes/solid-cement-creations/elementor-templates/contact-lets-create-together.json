                  "elType": "widget",
                  "widgetType": "icon-list",
                  "settings": {
                    "icon_list": [
                      {"text": "Instagram", "url": {"url": "https://instagram.com"}, "icon": "fab fa-instagram"},
                      {"text": "Pinterest", "url": {"url": "https://pinterest.com"}, "icon": "fab fa-pinterest"},
                      {"text": "Email", "url": {"url": "mailto:studio@solidcement.com"}, "icon": "fas fa-envelope"}
                    ],
                    "icon_color": "#ff1493"
                  },
                  "elements": [],
                  "isInner": true
                }
              ]
            }
          ]
        }
      ],
      "isInner": false
    }
