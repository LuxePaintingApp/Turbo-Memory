{
  "version": "0.4",
  "title": "Contact \u2014 Let\u2019s Create Together",
  "type": "page",
  "content": [
    {
      "id": "contact_intro",
      "elType": "section",
      "settings": {
        "padding": {
          "unit": "px",
          "top": "80",
          "right": "0",
          "bottom": "80",
          "left": "0",
          "isLinked": false
        },
        "background_background": "classic",
        "background_color": "#fff6fb"
      },
      "elements": [
        {
          "id": "contact_intro_column",
          "elType": "column",
          "settings": {
            "_column_size": 100
          },
          "elements": [
            {
              "id": "contact_intro_heading",
              "elType": "widget",
              "widgetType": "heading",
              "settings": {
                "title": "Let\u2019s Create Together",
                "header_size": "h1",
                "align": "center"
              }
            },
            {
              "id": "contact_intro_text",
              "elType": "widget",
              "widgetType": "text-editor",
              "settings": {
                "editor": "<p>Complete the form below or request a custom quote. Our artisans will be in touch within two business days.</p>",
                "align": "center"
              }
            }
          ],
          "isInner": false
        }
      ],
      "isInner": false
    },
    {
      "id": "contact_forms",
      "elType": "section",
      "settings": {
        "padding": {
          "unit": "px",
          "top": "60",
          "right": "0",
          "bottom": "60",
          "left": "0",
          "isLinked": false
        }
      },
      "elements": [
        {
          "id": "contact_forms_tabs",
          "elType": "widget",
          "widgetType": "tabs",
          "settings": {
            "tabs": [
              {
                "_id": "tab_contact",
                "tab_title": "Contact Form",
                "tab_content": "[contact-form-7 id=\"contact\"]"
              },
              {
                "_id": "tab_booking",
                "tab_title": "Booking Request",
                "tab_content": "[contact-form-7 id=\"booking-request\"]"
              }
            ]
          }
        }
      ],
      "isInner": false
    },
    {
